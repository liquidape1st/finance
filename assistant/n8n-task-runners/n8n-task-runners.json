{
    "task-runners": [
      {
        "runner-type": "javascript",
        "health-check-server-port": "5681",
        "working-directory": "/opt/runners/task-runner-javascript",
        "command": "node dist/task-runner-process.js",
        "env-overrides": {
          "NODE_FUNCTION_ALLOW_BUILTIN": "crypto",
          "NODE_FUNCTION_ALLOW_EXTERNAL": "moment,uuid"
        }
      },
      {
        "runner-type": "python",
        "health-check-server-port": "5682",
        "working-directory": "/opt/runners/task-runner-python",
        "command": "node dist/task-runner-process.js",
        "env-overrides": {
          "PYTHONPATH": "/opt/runners/task-runner-python",
          "N8N_RUNNERS_STDLIB_ALLOW": "json,random",
          "N8N_RUNNERS_EXTERNAL_ALLOW": "numpy,pandas"
        }
      }
    ]
  }